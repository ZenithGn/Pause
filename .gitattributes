# Normalize line endings so Windows/macOS/Linux contributors produce identical commits.
* text=auto

*.sql text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.py text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.example text eol=lf

*.bat text eol=crlf
*.png binary
*.jpg binary
*.webp binary
*.apk binary
*.jar binary
