# Supabase / Android local configuration
# Copy to `local.properties` (git-ignored) and fill in real values.
#
# Do NOT commit `local.properties`.

# Android SDK location
sdk.dir=C\:\\Users\\<you>\\AppData\\Local\\Android\\Sdk

# Supabase (Dashboard -> Project Settings -> API)
# Local stack: SUPABASE_URL=http://10.0.2.2:54321 (emulator -> host machine)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Google OAuth "Web application" client ID (used as serverClientId for Credential Manager)
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Cloudinary (Dashboard -> Product Environment Settings -> API Keys)
# Upload preset: Settings -> Upload -> Upload presets -> Add (Unsigned)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# PayOS (Cổng thanh toán thực tế: https://payos.vn)
# Vào payos.vn -> Đăng ký/Đăng nhập -> Kênh thanh toán -> Tạo kênh thanh toán -> Lấy thông tin kết nối:
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

